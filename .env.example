# ============ REQUIRED ============
DATABASE_URL=postgresql://crawlseo:crawlseo@localhost:5432/crawlseo

# Session secret AND the key used to encrypt stored credentials/tokens at rest.
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
# AUTH_SECRET works as an alias for Auth.js v5:
# AUTH_SECRET=

# ============ GOOGLE OAUTH (required for GSC data) ============
# Get these from: https://console.cloud.google.com/
# Enable: Search Console API, URL Inspection API, PageSpeed Insights API.
# Required scopes: openid, email, profile, https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Optional: PageSpeed Insights API key (higher quota for Core Web Vitals)
# GOOGLE_PAGESPEED_KEY=

# ============ NEXTAUTH / AUTH.JS ============
# Production: set to your public URL, e.g. https://seo.example.com
NEXTAUTH_URL=http://localhost:3000

# ============ SCHEDULING (POST /api/cron) ============
# This build ships no in-process scheduler. Drive syncs/alerts from an external
# cron that calls POST /api/cron with this bearer token. Generate with:
# openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32
# Example host crontab entries:
#   0 * * * * curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" https://seo.example.com/api/cron?job=gsc
#   0 4 * * * curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" https://seo.example.com/api/cron?job=vitals

# ============ OPTIONAL: Alert delivery ============
# Alerts are delivered per-alert by channel + config in the DB. These are
# global fallbacks used when an alert's own config has no destination.
# Generic JSON webhook (also the fallback for EMAIL-channel alerts):
# ALERT_WEBHOOK_URL=https://example.com/webhooks/crawlseo
# Slack incoming webhook:
# ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Telegram (from https://t.me/BotFather):
# TELEGRAM_BOT_TOKEN=your-bot-token-here
# TELEGRAM_CHAT_ID=your-chat-id-here
# NOTE: SMTP/email delivery is not wired in this build; EMAIL-channel alerts
# fall back to ALERT_WEBHOOK_URL if set.

# ============ OPTIONAL: Crawler identity ============
# User-Agent the crawler sends to sites it audits.
# CRAWLER_USER_AGENT=CrawlSEOBot/1.0 (+https://github.com/cptkrvs/crawlseo; self-hosted SEO audit)

# ============ NODE ENVIRONMENT ============
# NODE_ENV=development
